pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        skipStagesAfterUnstable()
    }

    environment {
        PYENV_HOME = "${WORKSPACE}/welcome/app/flask-volt-dashboard/.pyenv"
        PROJECT_HOME = "${WORKSPACE}/welcome/app/flask-volt-dashboard"
        FLASK_APP   = 'run.py'
        FLASK_ENV   = 'development'
        USER_CHOICE = ''   // will be set at QA gate
        APP_ENV = 'production'
        APP_DEBUG = 'false'
    }

    stages {
        stage('Clone Flask Project') {
            steps {
                git branch: 'jenkins-workshop', url: 'https://github.com/yanivomc/devopshift-welcome.git'
            }
        }

        stage('Build') {
            steps {
                echo "Building Volt app in environment: ${env.APP_ENV}"
                echo "Debug mode is set to: ${env.APP_DEBUG}"
                // Build steps here
            }
        }

        stage('Deploy') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'd4a71302-05ee-4fe5-9346-75f78de2c5ad', usernameVariable: 'TEST', passwordVariable: 'TEST')]) {
                    echo "Deploying with username ${env.USERNAME}"
                    // Use the credentials in your deployment steps
                    sh 'echo $USERNAME'
                    sh 'echo $PASSWORD'
                }
            }
        }

        stage('Setup Python Environment and Install Dependencies') {
            steps {
                dir("${PROJECT_HOME}") {
                    script {
                        sh '''#!/bin/bash
                        if ! command -v virtualenv &> /dev/null; then
                            echo "Installing virtualenv..."
                            pip install virtualenv
                        fi

                        rm -rf "$PYENV_HOME"
                        virtualenv "$PYENV_HOME"
                        source "$PYENV_HOME/bin/activate"
                        pip install -r requirements.txt
                        '''
                    }
                }
            }
        }

        stage('Run Flask Application') {
            steps {
                dir("${PROJECT_HOME}") {
                    script {
                        sh '''#!/bin/bash
                        source "$PYENV_HOME/bin/activate"
                        tasks=$(pgrep -f "flask run" || true)
                        if [ -n "$tasks" ]; then
                            echo "Stopping existing Flask application..."
                            for pid in $tasks; do
                                kill -9 "$pid" && echo "Killed process $pid"
                            done
                        fi
                        echo "Starting Flask application on 0.0.0.0:5005..."
                        nohup flask run --host=0.0.0.0 --port=5005 > flask_app.log 2>&1 &
                        '''
                    }
                }
            }
        }

        stage('Verify Application') {
            steps {
                dir("${PROJECT_HOME}") {
                    script {
                        sleep 5  // allow Flask to boot
                        def status = sh(script: "pgrep -f 'flask run' >/dev/null", returnStatus: true)
                        if (status != 0) {
                            echo "There is a problem with our flask application - printing log below"
                            sh 'cat flask_app.log || true'
                            error "Flask application is not running!"
                        } else {
                            echo "Flask application is running successfully."
                        }
                    }
                }
            }
        }
        stage('Parallel Tests') {
            parallel {
                stage('Test on Chrome') {
                    steps {
                        echo 'Testing VOLT on Chrome...'
                        // Chrome test steps here
                    }
                }
                stage('Test on Firefox') {
                    steps {
                        echo 'Testing VOLT on Firefox...'
                        // Firefox test steps here
                    }
                }
            }
        }
        /* -------------------- QA MANUAL GATE -------------------- */
        stage('QA Gate (Manual Approval)') {
            steps {
                script {
                    // אם אין את התוסף של milestone – אפשר למחוק את השורה הבאה
                    milestone(1)

                    def decision = null
                    try {
                        decision = timeout(time: 30, unit: 'MINUTES') {
                            input(
                                id: 'qaGate',
                                message: """QA sign-off required:
- Verify the Flask app at: http://${env.NODE_NAME}:5005 (or the agent's accessible IP)
- Confirm logs are healthy: ${env.WORKSPACE}/welcome/app/flask-volt-dashboard/flask_app.log
Is the application running successfully?""",
                                parameters: [
                                    choice(
                                        name: 'Decision',
                                        choices: 'Proceed\nAbort',
                                        description: 'Choose an option'
                                    )
                                ]
                                // , submitter: 'qa-user-1,qa-lead'
                                // , submitterParameter: 'ApprovedBy'
                            )
                        }
                    } catch (err) {
                        decision = 'Abort'
                        echo "QA gate timed out or was cancelled: defaulting to Abort."
                    }
                    env.USER_CHOICE = decision
                    echo "QA Decision: ${env.USER_CHOICE}"
                }
            }
        }
        /* -------------------------------------------------------- */

        stage('Continue the Pipeline') {
            when {
                beforeAgent true
                expression { env.USER_CHOICE == 'Proceed' }
            }
            steps {
                script {
                    echo 'Continuing the pipeline...'
                    // deploy/test/promote...
                }
            }
        }

        stage('Abort the Pipeline') {
            when {
                beforeAgent true
                expression { env.USER_CHOICE == 'Abort' }
            }
            steps {
                script {
                    error 'Pipeline aborted by the user (QA gate).'
                }
            }
        }

        stage('Finalize the Pipeline') {
            steps {
                script {
                    if (env.USER_CHOICE == 'Proceed') {
                        echo 'Pipeline completed successfully.'
                    } else {
                        echo 'Pipeline aborted by the user or timeout at QA gate.'
                    }
                }
            }
        }
        stage('archiveArtifacts') {
            steps {
                    dir("${PROJECT_HOME}") {
                    archiveArtifacts artifacts: 'flask_app.log', allowEmptyArchive: true
                    }
            }
        }
    }

    post {
        always {
            dir("${PROJECT_HOME}") {
                echo 'Cleaning up workspace...'
                sh 'rm -rf "$PYENV_HOME" || true'
            }
        }
    }
}
